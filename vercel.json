{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/server.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ]
}
