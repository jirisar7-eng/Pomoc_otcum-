rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function for admin check
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "mallfuriionn@gmail.com" ||
        request.auth.token.email == "admin@synthesis.cz" ||
        request.auth.token.role == "admin" ||
        request.auth.token.role == "superadmin"
      );
    }

    // 1. PUBLIC READ COLLECTIONS (CMS, Categories, Rulings, Templates, SOS Institutions, Articles)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /judikaty/{judikatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /document_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crisis_institutions/{institutionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /experience_stories/{storyId} {
      allow read: if true;
      allow create: if true; // Allows anonymous sharing
      allow update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 2. USER PRIVATE WORKSPACE & TOOL SAVES
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /alimony_calculations/{calcId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /custody_simulations/{simId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /court_cases/{caseId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /case_documents/{docId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ai_case_logs/{logId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /coparent_connections/{connId} {
      allow read, write: if isAuthenticated();
    }

    match /coparent_events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    match /coparent_diary/{diaryId} {
      allow read, write: if isAuthenticated();
    }

    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
