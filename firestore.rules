rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@synthesis.cz' ||
        request.auth.token.email.matches('.*admin@.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isConnectionParent(connectionId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/coparent_connections/$(connectionId)).data.parent1Id == request.auth.uid ||
        ('parent2Id' in get(/databases/$(database)/documents/coparent_connections/$(connectionId)).data &&
         get(/databases/$(database)/documents/coparent_connections/$(connectionId)).data.parent2Id == request.auth.uid)
      );
    }

    // Users (members) profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
      
      // Users documents registry
      match /documents/{documentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Articles
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Experience Stories
    match /stories/{storyId} {
      allow read: if true;
      allow create: if true; // Any user can submit a story
      allow update, delete: if isAdmin();
    }

    // Forum Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Donations
    match /donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Co-parent Connections (Shared family pairs)
    match /coparent_connections/{connectionId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (
        resource.data.parent1Id == request.auth.uid ||
        ('parent2Id' in resource.data && resource.data.parent2Id == request.auth.uid) ||
        isAdmin()
      );
    }

    // Co-parent Shared Calendar
    match /coparent_calendar/{eventId} {
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid &&
        isConnectionParent(request.resource.data.connectionId);
      allow read, update, delete: if isSignedIn() && (
        isConnectionParent(resource.data.connectionId) ||
        isAdmin()
      );
    }

    // Co-parent Shared Child Diary
    match /coparent_diary/{diaryId} {
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid &&
        isConnectionParent(request.resource.data.connectionId);
      allow read, update, delete: if isSignedIn() && (
        isConnectionParent(resource.data.connectionId) ||
        isAdmin()
      );
    }

    // Co-parent Secured Chat
    match /coparent_chat/{messageId} {
      allow create: if isSignedIn() && 
        request.resource.data.senderId == request.auth.uid &&
        isConnectionParent(request.resource.data.connectionId);
      allow read, update, delete: if isSignedIn() && (
        isConnectionParent(resource.data.connectionId) ||
        isAdmin()
      );
    }
  }
}
