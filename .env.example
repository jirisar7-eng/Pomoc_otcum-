# AI Provider Selection: 'gemini' (default), 'openai', or 'anthropic' / 'claude'
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI Configuration (Optional if AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic / Claude Configuration (Optional if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides for custom hosting/deployments like Vercel)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Supabase Configuration
VITE_SUPABASE_URL="https://brqqinbxpluzrkrvpfqs.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_7cyVhGBBXM0N99dcqjGZxg_O3dq748D"
NEXT_PUBLIC_SUPABASE_URL="https://brqqinbxpluzrkrvpfqs.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_7cyVhGBBXM0N99dcqjGZxg_O3dq748D"

# WEDOS SMTP Configuration
SMTP_HOST="smtp.wedos.net"
SMTP_PORT="587"
SMTP_USER="info@tatovacesta.cz"
SMTP_PASS=""
SMTP_PASSWORD=""
SMTP_FROM="info@tatovacesta.cz"

# GitHub API Integration Configuration
# Required for reading and committing files/data directly to GitHub repository (e.g., owner/Pomoc_otcum)
